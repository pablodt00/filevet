{
  "$defs": {
    "AnalyzerRun": {
      "properties": {
        "analyzer": {
          "title": "Analyzer",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "timeout"
          ],
          "title": "Status",
          "type": "string"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "analyzer",
        "version",
        "artifact_id",
        "status",
        "duration_ms"
      ],
      "title": "AnalyzerRun",
      "type": "object"
    },
    "Artifact": {
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "md5": {
          "title": "Md5",
          "type": "string"
        },
        "declared_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declared Type"
        },
        "detected_type": {
          "title": "Detected Type",
          "type": "string"
        },
        "depth": {
          "default": 0,
          "title": "Depth",
          "type": "integer"
        },
        "parent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        }
      },
      "required": [
        "name",
        "size",
        "sha256",
        "md5",
        "declared_type",
        "detected_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "rule_id": {
          "pattern": "^[a-z]+\\.[a-z0-9_]+$",
          "title": "Rule Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "artifact_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "analyzer": {
          "default": "",
          "title": "Analyzer",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "title",
        "severity"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Location": {
      "properties": {
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        },
        "xpath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xpath"
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "archive_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Path"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "properties": {
    "filevet_version": {
      "default": "0.0.2",
      "title": "Filevet Version",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "analyzer_runs": {
      "items": {
        "$ref": "#/$defs/AnalyzerRun"
      },
      "title": "Analyzer Runs",
      "type": "array"
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/Severity"
      },
      "readOnly": true,
      "title": "Summary",
      "type": "object"
    },
    "verdict": {
      "enum": [
        "pass",
        "review",
        "block"
      ],
      "readOnly": true,
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "artifacts",
    "findings",
    "analyzer_runs",
    "summary",
    "verdict"
  ],
  "title": "Report",
  "type": "object"
}
